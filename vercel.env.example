# Vercel Phase 2 — copy into Vercel → Environment Variables (Production + Preview).
# See docs/deployment.md Phase 2.2

# Required for Vercel build — Railway public URL from Phase 1.5 (no trailing slash).
# Used at build time to proxy /api/* on Vercel -> Railway (not embedded in browser JS).
VITE_API_BASE_URL=https://your-railway-service.up.railway.app

# Alternative name (same effect as VITE_API_BASE_URL during Vercel build)
# RAILWAY_API_URL=https://your-railway-service.up.railway.app
