# Mutual Fund FAQ Assistant — environment template
# Copy to `.env` and fill in values. Never commit `.env`.

# Required: Groq API key for generation (facts-only RAG answers)
GROQ_API_KEY=

# Optional: Groq-hosted instruct model (default: openai/gpt-oss-120b; low temperature in app code)
GROQ_MODEL=openai/gpt-oss-120b

# Groq openai/gpt-oss-120b rate limits (local guard; match your Groq console tier)
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000

# UI / API
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UI_MIN_SECONDS_BETWEEN_REQUESTS=2

# Embeddings (local sentence-transformers; BGE-small with query/doc prefixes in app code)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store (Chroma local path)
VECTOR_STORE_PATH=data/vectorstore
CHROMA_COLLECTION=mutual_fund_chunks

# Corpus paths
MANIFEST_PATH=data/manifest.yaml
PARSED_DIR=data/processed/parsed
CHUNKS_DIR=data/processed/chunks
STRUCTURED_FACTS_PATH=data/processed/structured_facts.yaml
RAW_DIR=data/raw
FETCH_LOG_PATH=data/raw/fetch_log.yaml
FETCH_TIMEOUT_SECONDS=30
# CI scheduler: reuse committed raw HTML when indmoney blocks GitHub runner IPs
FETCH_FALLBACK_CACHED=false
FETCH_RETRY_COUNT=3
FETCH_INTER_SCHEME_DELAY_SECONDS=1.0
# Optional: HuggingFace token for faster embedding model downloads in CI
# HF_TOKEN=

# Logging (ingest pipeline, API, scripts)
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# --- Railway Phase 1 (backend) ---
# Copy railway.env.example → Railway Variables. Never commit secrets.
# CORS_ORIGINS=https://your-app.vercel.app
