# Railway Phase 1 — copy these into Railway → Variables (never commit secrets).
# See docs/deployment.md Phase 1.3

# Required
GROQ_API_KEY=gsk_your_key_here
CORS_ORIGINS=http://localhost:5173

# Optional (defaults also set in railway.toml [deploy.env])
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE_PATH=data/vectorstore
CHROMA_COLLECTION=mutual_fund_chunks
MANIFEST_PATH=data/manifest.yaml
LOG_LEVEL=INFO
