# Vercel Phase 2 — copy into Vercel → Environment Variables (Production + Preview).
# See docs/deployment.md Phase 2.2
#
# Use RAILWAY_API_URL (recommended). The build proxies /api/* on Vercel to this URL.
# Do NOT rely on VITE_API_BASE_URL on Vercel — it gets embedded in browser JS and
# triggers cross-origin CORS calls to Railway.

RAILWAY_API_URL=https://your-railway-service.up.railway.app
